$config['smtp_host'] = 'tls://localhost:587';
$config['smtp_user'] = '%u';  // Default.
$config['smtp_pass'] = '%p';  // Default.
$config['smtp_auth_type'] = 'PLAIN';
$config['smtp_helo_host'] = '{{ m['webmail_domain'] }}';



// ------------
// TLS settings
// ------------

// See <https://www.php.net/manual/en/context.ssl.php>.

$default_tls_options = [
  'verify_peer' => true,
  'verify_peer_name' => true,
  'allow_self_signed' => false,
  'capath' => '/etc/ssl/certs',

  // Ciphers for TLS <= 1.2.
  //  - Implicitly require TLSv1.2 here.
  //    - We apparently cannot restrict to TLSv1.3.
  //  - See Dovecot's `tls.conf#ssl_cipher_list`.
  //  - We could restrict this to a single cipher.
  'ciphers' => 'TLSv1.2+HIGH+ECDHE+aRSA+CHACHA20:HIGH+ECDHE+aRSA+AESGCM:@STRENGTH',

  'disable_compression' => true,  // See Dovecot's `tls.conf#ssl_options`.

  // "Security level"
  //  - See <https://www.openssl.org/docs/man1.1.1/man3/SSL_CTX_get_security_level.html>.
  //  - level 2 means >= 112 bits of security, >= 2048 bit RSA keys.
  //  - We cannot go to a higher level or else the certificate verification
  //    fails.
  'security_level' => 2,
];


// `peer_name` must be a name in the certificate that Dovecot/Postfix serve (see
// `states/lawandorga-mail/dovecot/files/base/tls.conf.j2#ssl_server_cert_file`
// and `states/lawandorga-mail/postfix/files/main.cf.j2#smtpd_tls_chain_files`,
// both pointing at /etc/letsencrypt/live/<letsencrypt_domainset>/).  We use
// $letsencrypt_domainset, the lineage's first name, which is in the certificate
// by construction.
//  - Not $fqdn/$mail_dovecot_hostname/$mail_postfix_myhostname: those are the
//    mail identity (Dovecot's `hostname`, Postfix' `myhostname`) and need not
//    be covered by the certificate.  They only work here as long as they happen
//    to be listed in the `letsencrypt` pillar's domainset.
$config['imap_conn_options'] = [
  'ssl' => array_replace($default_tls_options, [
    'peer_name' => '{{ m['letsencrypt_domainset'] }}',
  ]),
];

$config['smtp_conn_options'] = [
  'ssl' => array_replace($default_tls_options, [
    'peer_name' => '{{ m['letsencrypt_domainset'] }}',
  ]),
];



// ------
// SYSTEM
// ------

$config['enable_installer'] = false;  // Default.

// CONSIDER:
//$config['advanced_prefs']

$config['support_url'] = '{{ m['web_app_mail_support_url'] }}';

// TODO:
