//  * This does not include all, but many settings.
{% set m = pillar['lawandorga_mail'] %}

$config = [];



// ------------
// SQL DATABASE
// ------------

// `sslmode=require` forces a TLS-encrypted connection to the database server.
//  - Roundcube's pgsql driver passes recognised libpq parameters (incl.
//    sslmode) from the DSN query string through to PDO.
{# The password must be URL-encoded: Roundcube's DSN parser rawurldecode()s it,
   and an unencoded `@ : / ? #` would corrupt the DSN.  Jinja's `urlencode`
   escapes everything except the unreserved set and `/`, hence the explicit
   replace for `/`. #}
{% set _db_password = pillar['passbolt'][m['database_password_uuid']] | urlencode | replace('/', '%2F') %}
$config['db_dsnw'] = "pgsql://{{ m['database_user'] }}:{{ _db_password }}@{{ m['database_server_address'] }}:{{ m['database_server_port'] }}/{{ m['database_name_webmail'] }}?sslmode=require";



