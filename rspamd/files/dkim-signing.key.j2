{#- The Passbolt secret holds the base64 key body only; the PEM markers are
    added here.  OpenSSL rejects a PEM whose markers are not on their own line,
    which is what happens when Passbolt collapses the stored key to one line.
    Markers are stripped first, so a secret that still contains them also
    renders correctly. -#}
{%- set m = pillar['lawandorga_mail'] -%}
{%- set body = pillar['passbolt'][m['mail_dkim_key_uuid']]
      | regex_replace('-----(BEGIN|END) [A-Z0-9 ]+?-----', '')
      | regex_replace('\\s+', '') -%}
-----BEGIN RSA PRIVATE KEY-----
{% for i in range(0, body | length, 64) %}{{ body[i:i + 64] }}
{% endfor %}-----END RSA PRIVATE KEY-----
