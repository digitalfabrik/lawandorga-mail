{% set m = pillar['lawandorga_mail'] %}
# Postmaster aliases (and sender login maps) for database domains.
#  - See
#    - `/doc/mail/postfix/aliases/static.md`,
#    - `/doc/mail/postfix/postmaster.md`,
#    - `/doc/mail/postfix/aliases.md`.

hosts = {{ m['database_server_address'] }}:{{ m['database_server_port'] }}
user = {{ m['database_user'] }}
password = {{ pillar['passbolt'][m['database_password_uuid']] }}
# Require a TLS-encrypted connection.  Postfix's pgsql client has no sslmode
# field, but libpq parses the dbname value as a conninfo string when it
# contains '=', which lets us set sslmode here.
dbname = dbname={{ m['database_name_mail'] }} sslmode=require

expansion_limit = 1

query =
  SELECT '{{ m['mail_admin_address'] }}'
  FROM core_maildomain
  WHERE name NOT IN ({{ "'" + m['mail_static_domains'] | join("', '") + "'" }})
  AND   is_active
  AND   '%u' = 'postmaster'
  AND   name = '%d'
  ;
